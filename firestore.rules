rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isViceAdmin() {
      return isAuthenticated() && getUserData().role == 'vice_admin';
    }
    
    function isSupervisor() {
      return isAuthenticated() && getUserData().role == 'supervisor';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }
    
    function isManagement() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'vice_admin');
    }
    
    function hasCircleAccess(circleId) {
      return isAuthenticated() && (
        isManagement() ||
        (getUserData().assignedCircleIds != null && circleId in getUserData().assignedCircleIds)
      );
    }
    
    // المستخدمون
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth.uid == userId && 
        !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('permissions' in request.resource.data.diff(resource.data).affectedKeys())
      );
    }
    
    // الحلقات
    match /circles/{circleId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagement();
      allow delete: if isAdmin();
    }
    
    // الطلاب
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isManagement() || (isTeacher() && getUserData().permissions.canAddStudent == true);
      allow update: if isManagement() || (isTeacher() && hasCircleAccess(resource.data.circleId));
      allow delete: if isAdmin();
    }
    
    // الحضور والغياب
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasCircleAccess(request.resource.data.circleId);
      allow update: if isManagement() || (isTeacher() && hasCircleAccess(resource.data.circleId));
      allow delete: if isManagement();
    }
    
    // الحفظ والمراجعة
    match /memorization/{memId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && hasCircleAccess(request.resource.data.circleId);
      allow delete: if isManagement();
    }
    
    // الاختبارات
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagement() || isTeacher();
      allow delete: if isManagement();
    }
    
    // الدرجات
    match /grades/{gradeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && hasCircleAccess(request.resource.data.circleId);
      allow delete: if isManagement();
    }
    
    // الرسوم
    match /fees/{feeId} {
      allow read: if isManagement() || (isSupervisor() && getUserData().permissions.canViewFees == true);
      allow create, update: if isManagement();
      allow delete: if isAdmin();
    }
    
    // التقارير الشهرية
    match /monthly_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isManagement() || (isTeacher() && resource.data.teacherId == request.auth.uid && resource.data.status == 'draft');
      allow delete: if isAdmin();
    }
    
    // الإشعارات
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
    
    // سجل التدقيق audit_logs
    match /audit_logs/{logId} {
      allow read: if isManagement();
      allow create: if isAuthenticated();
      allow update, delete: if false; // ممنوع التعديل أو الحذف إطلاقاً
    }
    
    // الإعدادات
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
